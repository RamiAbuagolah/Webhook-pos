{
  "WebhookEngine": {
    "Routes": [
      {
        "EventType": "OrderCreated",
        "Channel": "STP",
        "DestinationKey": "STP_WEBHOOK",
        "OperationKey": "OrderCreated",
        "MapperKey": "STP_ORDER_CREATED"
      },
      {
        "EventType": "OrderCancelled",
        "Channel": "PRO",
        "DestinationKey": "PRO_WEBHOOK",
        "OperationKey": "OrderCancelled",
        "MapperKey": "PRO_ORDER_CANCELLED"
      }
    ],
    "Destinations": {
      "STP_WEBHOOK": {
        "HttpClientName": "Webhook.STP",
        "BaseUrl": "https://stp.example.com",
        "TimeoutSeconds": 30,
        "RetryCount": 3,
        "Operations": {
          "OrderCreated": {
            "Path": "/api/webhooks/orders/created",
            "Method": "POST",
            "AuthPolicies": [
              {
                "Type": "BearerStatic",
                "ValueSettingName": "STP_ORDER_CREATED_TOKEN"
              }
            ]
          }
        }
      },
      "PRO_WEBHOOK": {
        "HttpClientName": "Webhook.PRO",
        "BaseUrl": "https://pro.example.com",
        "TimeoutSeconds": 30,
        "RetryCount": 3,
        "Operations": {
          "OrderCancelled": {
            "Path": "/api/contracts/cancelled",
            "Method": "POST",
            "AuthPolicies": [
              {
                "Type": "ApiKey",
                "HeaderName": "X-API-Key",
                "ValueSettingName": "PRO_ORDER_CANCELLED_API_KEY"
              }
            ]
          }
        }
      }
    }
  }
}
